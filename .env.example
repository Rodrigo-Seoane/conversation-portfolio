# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local — it is git-ignored.
# Keys go in .env.local and in Vercel environment variables.
# See CLAUDE.md §4 for the security rule.

# Anthropic — required. Never hardcode the model name in code; read it from CHAT_MODEL.
ANTHROPIC_API_KEY=
# Default model. Cheaper fallback: claude-haiku-4-5.
CHAT_MODEL=claude-sonnet-5

# Supabase — optional in the MVP (Phase 6, anonymous question log only).
# URL is public, keys are secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
